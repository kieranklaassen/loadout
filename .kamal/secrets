# Secrets referenced by config/deploy.yml (registry/password and env/secret).
#
# Every value is resolved at DEPLOY TIME via shell indirection — no raw
# credential is ever written here, so this file is safe to commit. DO NOT paste
# resolved secrets into this file.

# Registry password: a GitHub token for ghcr.io (uses your local gh login).
KAMAL_REGISTRY_PASSWORD=$(gh auth token)

# Rails master key, read from the untracked config/master.key.
RAILS_MASTER_KEY=$(cat config/master.key)

# Riffrec capture API key, passed through from the deploy environment. Leave it
# unset in the environment to run with feedback capture disabled (the default).
