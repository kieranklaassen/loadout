# Copy to .env for local reference. Every value is OPTIONAL in development — unset
# variables fall back to safe defaults (LLM providers unavailable, SSR off, capture
# off). PUBLIC_BASE_URL is the exception: production refuses to boot without it.
# This file carries PLACEHOLDER NAMES ONLY. Never commit real keys or endpoints.

# --- Sign in with Every (unset = sign-in says it is not configured) ---
EVERY_OAUTH_CLIENT_ID=
EVERY_OAUTH_CLIENT_SECRET=
EVERY_OAUTH_BASE_URL=
# Default "openid basic_profile"; "basic_profile" alone turns silent sign-in off.
EVERY_OAUTH_SCOPE=
# Public origin, e.g. https://toolbox.every.to (OAuth redirect, MCP issuer, share links, and
# the only Host production answers to, besides /up). REQUIRED in production; in development
# unset means links follow the request.
PUBLIC_BASE_URL=
# Comma-separated admin emails (catalog review, /admin/flipper); an address counts only once Every verified it
ADMIN_EMAILS=
# Comma-separated hosts a model's Vibe Check link may use, matched exactly, https only. Setting it
# replaces the defaults (unset = every.to,checks.every.to).
VIBE_CHECK_HOSTS=

# --- ruby_llm (LLM providers; unset = that provider is unavailable) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RUBY_LLM_MODEL=
RUBY_LLM_REQUEST_TIMEOUT=

# --- Background jobs ---
JOB_CONCURRENCY=

# --- Inertia SSR (off by default) ---
INERTIA_SSR_ENABLED=
INERTIA_SSR_TIMEOUT=

# --- Riffrec feedback capture (both required to enable; unset = no-op) ---
# PLACEHOLDER NAMES ONLY. Never commit a real key or a live endpoint.
RIFFREC_PUBLIC_KEY=
RIFFREC_ENDPOINT=
